# ── mcp_server 設定：複製成 .env 再填 ──  cp .env.example .env

# 監聽位址（docker 內用 0.0.0.0；本機非 docker 開發可留預設）
MCP_HOST=0.0.0.0
MCP_PORT=9200

# db_api 位址（查 emp_id 對應的 RAG 權限用；docker 內用服務名）
DB_API_URL=http://db_api:9000

# ── 公司 RAG 知識庫（knowledge_search tool）── 跟原本 backend 的設定一致
RAG_BASE_URL=http://172.16.174.116:8000
RAG_TOPK=5
# RAG_VERIFY_SSL=false
# RAG_FILTER=[{"allowDirect":"Y","compCode":"AVC","depCode":"IT","docType":"","empID":"","metadataIds":""}]

# 料號查詢／CAR、LL、MRB、報廢等關鍵字：常對應數十甚至數百筆資料，用較大的 topk 查詢
# RAG_TOPK_EXPANDED=50
# 第一次查詢剛好撈滿 topk（可能被截斷）時，自動用這個上限再查一次
# RAG_TOPK_MAX=100
# 觸發「擴大搜尋」的關鍵字，逗號分隔（不含料號格式，那是規則式偵測，不受此變數影響）
# RAG_EXPAND_KEYWORDS=CAR,LL,MRB,報廢

# 前端勾選的「自訂檢索範圍」在記憶體裡的存活秒數（預設 86400）。backend 每次轉發
# 問題前都會重寫一次，所以這個值只是用來回收沒人再用的舊 session，不是功能的一部分。
# 詳見 app/module/kb_scope.py。
# KB_SCOPE_TTL=86400

# ── 天氣 tool 示範用假資料，無需設定 ──

# ── 網路搜尋（web_search / read_url）──
# 搜尋來源：目前支援 duckduckgo（免 API key）。之後要換付費源在 web_search.py 加分支。
# WEB_SEARCH_PROVIDER=duckduckgo
# 每次搜尋回傳幾筆（1-10）
# WEB_SEARCH_MAX_RESULTS=5
# DuckDuckGo 地區碼：wt-wt（全球）、tw-tzh（台灣）、us-en（美國）…
# WEB_SEARCH_REGION=wt-wt
# read_url 抓網頁的逾時秒數與內文截斷長度
# READ_URL_TIMEOUT=20
# READ_URL_MAX_CHARS=8000

# ── KB search 檢索紀錄（app/module/kb_log.py）──
# 每次 knowledge_search / knowledge_search_plain 都會把「帶進來的 filter 參數
# ＋完整結果」append 成一行 JSON，一天一個 kb_search-YYYY-MM-DD.jsonl。
# 主要用途：knowledge_search_plain 的 filter_criteria 是模型自己填的（可能填錯
# 或漏填），出事時得能回頭確認當時到底帶了什麼、因此撈到什麼。
# KB_LOG_ENABLED=false 可整個關掉；KB_LOG_DIR 是容器內路徑，
# docker-compose 已經把它掛到 host 的 mcp_server/log。
# KB_LOG_ENABLED=true
# KB_LOG_DIR=/app/log

# ── 使用者自建技能（code 技能的沙盒服務）── INTERNAL_TOKEN 要跟 skill_runner/.env 一致
SKILL_RUNNER_URL=http://skill_runner:8100
SKILL_RUNNER_TOKEN=

# ── 結構化資料庫查詢（structured_db tool）── MSSQL，連線資訊拆開存（不要自己拼
# 一整串連線字串塞密碼，密碼裡有特殊字元（例如 ^、@）容易把連線字串本身弄壞；
# 用 sqlalchemy.engine.URL.create() 組，特殊字元由 SQLAlchemy 自己處理跳脫）。
# 強烈建議用專門開的唯讀帳號（GRANT SELECT / db_datareader），不要用 sa 這種系統
# 管理員帳號——MSSQL 沒有 Postgres 那種 session 層級的唯讀交易可以當第二道防線，
# 帳號本身的權限範圍就是最主要的防護。
STRUCTURED_DB_HOST=
STRUCTURED_DB_PORT=1433
STRUCTURED_DB_NAME=master
STRUCTURED_DB_USER=
STRUCTURED_DB_PASSWORD=
# 單次查詢逾時秒數、最多回傳幾列（不管產生的 SQL 有沒有加 TOP，都在應用層截斷）
STRUCTURED_DB_TIMEOUT_S=10
STRUCTURED_DB_ROW_LIMIT=200
# HCM_EmployeeData 的欄位允許清單（逗號分隔）。這張員工主檔共 135 個欄位，
# 只有列在這裡的查得到，其餘（身分證、銀行帳號、護照、住址、個人手機、緊急聯絡人、
# 密碼、推播 token 等）會被 app/module/structured_db.py 擋下來。
# 留空或整行拿掉 = 整張表都不開放查詢（fail closed，不是全開）。
STRUCTURED_DB_HCM_ALLOWED_COLUMNS=EmployeeDataID,MemID,WID,GroupWID,UserName,UserEnglishName,DepCode,DepName,DivisionDepCode,GroupDepCode,VirtDepCode,VirtDepCodeName,BranchCode,SiteType,AreaCode,TitleCode,TitleCodeName,PositionCode,PositionCodeName,StandardJobTitle,JobCode,NewJobLevel,JobCategory1,JobCategory2,Responsibility,DirectType,HiringMode,ClassesCode,Resign,ResignDate,ReinstatementDate,ResidentStatus,StatusCode,IsLeaveWithoutPay,LeaveWithoutPayDate,OnBoardDate,GroupOnboardDate,IsPassTrialPeriod,TrialPeriodFullDate,CompanySeniority,GroupSeniority,PreviousSeniority,Email,EmpEmail,OfficePhone,CreateStamp,UpdateStamp

# text-to-SQL 用的模型——這是「把問題轉成 SQL」這種機械式轉換的子任務，跟
# orchestrator.py 的 query_rewrite/classify_intent 一樣，故意用便宜/快的模型就好，
# 不需要主力模型。跟 backend/.env 用同一個 gateway，只是這裡是 mcp_server 自己的設定。
LLM_BASE_URL=https://devops.avc.co:28003/LLM_api/v1
LLM_MODEL=google/gemma-4-31B-it
LLM_API_KEY=123456
# LLM_VERIFY_SSL=false

# ── 知識庫 chunk 全文（get_kb_chunks tool）── Azure AI Search 的 docs/search REST API
# 流程是兩段：先用 query_kb_attachments 依表單號碼（CAR3-*/PDP*）查
# AI_Library_KBMetadata / AI_Library_KBFile 拿到 MetadataID+FileID，再用
# get_kb_chunks 打這裡撈那份檔案的 chunk 全文（search=* + filter 精確比對，
# 不是語意檢索）。索引欄位名稱是 MetadataId／FileId（小寫 d），跟資料庫的
# MetadataID／FileID 不一樣，OData filter 要照索引那邊寫。
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_VERSION=2024-07-01
AZURE_SEARCH_KEY=
AZURE_SEARCH_TIMEOUT=30
# AZURE_SEARCH_VERIFY_SSL=false
# 打 API 時撈幾筆。要能一次拿完整份文件（才知道總共幾個 chunk、也才能依 ChunkId
# 排成文件順序），所以維持原本 REST 範例的 1000；回給模型的量是下面兩個變數在管。
# AZURE_SEARCH_TOP=1000
# select 的欄位（索引那邊要設成可取回才行；FileId 實測 vector-index-1 可以取回，
# 沒它的話「只給 metadata_id」那種多檔案模式分不出 chunk 屬於哪個檔案）。
# AZURE_SEARCH_SELECT=ChunkId, FileName, MetadataId, FileId, Content
# 回給模型的上限：最多幾個 chunk、每個 chunk 最多幾個字。一份大 pdf 動輒上百個
# chunk、全文上萬字，整包塞回去會灌爆 context；總筆數會照實回報（@odata.count），
# 所以模型知道自己只看到一部分。
# KB_CHUNK_LIMIT=20
# KB_CHUNK_MAX_CHARS=1200
# 可看範圍檢查（預設 true）。get_kb_chunks 沒辦法知道呼叫者是誰（openclaw 的 MCP
# header 是設定檔裡的固定值，不能依每次呼叫帶入登入者），所以預設只放行
# AI_Library_KBMetadata 的 CompCode/DepCode/EmpID 都是 'ALL'（全公司可見）的文件；
# 個人上傳（PERSONAL，一律綁特定 EmpID）與部門限定的 ISO 文件會被擋下來。
# 設成 false 就是任何人拿到 MetadataID 都能撈到那份文件的內容，要開放前想清楚。
# KB_CHUNK_SCOPE_GUARD=true
